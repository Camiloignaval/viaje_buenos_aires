# Vite 8 trae @vitejs/plugin-react@6 (babel 8 vía @rolldown/plugin-babel) y
# vite-plugin-pwa trae workbox-build (babel 7). npm en modo estricto marca el
# choque de peers aunque ambos coexisten sin problema en runtime (versiones
# anidadas). Este flag hace la instalación reproducible en local y en CI.
legacy-peer-deps=true
